{
  "name": "ten-styles",
  "version": "1.0.0",
  "private": true,
  "description": "Один круг — десять стилей: 2D-ролик на Remotion",
  "scripts": {
    "studio": "remotion studio",
    "check": "tsc --noEmit",
    "audio": "python3 scripts/make_audio.py",
    "audio:report": "python3 scripts/audio_report.py public/audio/soundtrack.wav",
    "render:preview": "remotion render TenStyles renders/preview.mp4 --scale=0.5 --codec=h264 --pixel-format=yuv420p --crf=23",
    "render:final": "remotion render TenStyles renders/final.mp4 --codec=h264 --pixel-format=yuv420p --crf=17",
    "still": "node scripts/still.mjs",
    "styleframes": "python3 scripts/styleframes.py",
    "qa:frames": "python3 scripts/extract_frames.py renders/preview.mp4 qa/frames --interval 0.5"
  },
  "dependencies": {
    "@fontsource/exo-2": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/poiret-one": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "@fontsource/rubik-mono-one": "5.3.0",
    "@fontsource/russo-one": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@remotion/cli": "4.0.532",
    "@remotion/media": "4.0.532",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  }
}
